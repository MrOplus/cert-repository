{
  "name": "certstore",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "description": "Self-hosted SSL certificate store: issues & renews Let's Encrypt certs via Cloudflare DNS-01 and serves them over an authenticated API",
  "dependencies": {
    "acme-client": "^5.4.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
